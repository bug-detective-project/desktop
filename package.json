{
  "name": "bug-detective",
  "productName": "Bug Detective",
  "version": "0.1.0",
  "description": "A desktop game where developers practice debugging a real app.",
  "author": "Bug Detective",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bug-detective-project/desktop.git"
  },
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1",
    "pnpm": ">=12.15.0"
  },
  "scripts": {
    "electron:install": "install-electron --no",
    "prepare:resources": "node tools/prepare-resources.ts",
    "predev": "pnpm run prepare:resources",
    "dev": "electron-vite dev",
    "build": "pnpm run prepare:resources && electron-vite build && node tools/write-notices.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:stories": "vitest run --project stories",
    "test:coverage": "vitest run --project unit --project stories --coverage",
    "pretest:coverage:full": "pnpm run prepare:resources",
    "test:coverage:full": "vitest run --project unit --project stories --project integration --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm run build && playwright test",
    "test:real-runtime": "pnpm run build && playwright test --config playwright.real-runtime.config.ts",
    "test:e2e:headless:linux": "pnpm run build && env -u WAYLAND_DISPLAY xvfb-run -a --server-args=\"-screen 0 1600x1000x24\" playwright test",
    "dist:win": "pnpm run build && electron-builder --win nsis --publish never",
    "prepare": "husky",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node tools/lint/node_modules/eslint/bin/eslint.js . --fix",
    "pretest:integration": "pnpm run prepare:resources",
    "verify:push": "pnpm run typecheck && pnpm test",
    "check:action-pins": "node tools/check-action-pins.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@bug-detective/catalog": "github:bug-detective-project/catalog#v1.1.0",
    "fflate": "0.8.3",
    "tar-stream": "3.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tar-stream": "3.1.5",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-devtools-installer": "4.0.0",
    "electron-vite": "6.0.0",
    "husky": "9.1.7",
    "i18next": "26.5.11",
    "lint-staged": "17.6.0",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "storybook": "10.6.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": "node tools/lint/node_modules/eslint/bin/eslint.js --fix"
  }
}
