# Development settings, read by `pnpm run dev` and the unpackaged app (never by the installer).
# Copy to .env and change what you need.

# Shows "Solve bug" on the In Progress card: it puts the ticket's reference fix into your code.
BUGDETECTIVE_DEV_SOLVE_BUG_BUTTON=false

# Shows "Skip onboarding" in Rafaela's onboarding (the first time, players cannot skip it).
BUGDETECTIVE_DEV_SKIP_ONBOARDING_BUTTON=false

# Shows the Projects screen from the start (normally it waits until a project is done).
BUGDETECTIVE_DEV_SHOW_PROJECTS=false

# Memory and pids limits of the containers, as `docker run --memory` and `--pids-limit` take them.
# Read when a container is created, so a change applies to the next one. Leave them out (or
# invalid) to keep the defaults: 3g and 1024 for the workspace, 2g and 512 for QA.
BUGDETECTIVE_WORKSPACE_MEMORY=3g
BUGDETECTIVE_WORKSPACE_PIDS=1024
BUGDETECTIVE_QA_MEMORY=2g
BUGDETECTIVE_QA_PIDS=512
